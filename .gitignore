# ==========================================
# 1. 优先拉黑巨型/垃圾文件夹
# ==========================================
.vscode/
.vscode-server/
.venv/
__pycache__/
.local/
build/
node_modules/

# ==========================================
# 2. 忽略所有文件和文件夹
# ==========================================
*

# ==========================================
# 3. 白名单机制（放行）
# ==========================================
# 注意这里：不要用 !*/ 放行所有文件夹
# 而是精准放行你放代码的目录（假设你代码都在 src 和 te 里）
!src/
!te/

# 放行你需要的文件类型
!*.c
!*.h
!*.md
!*.txt
!.gitignore
